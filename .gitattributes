# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force specific text files to use LF
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.js text eol=lf

# Explicitly declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.zip binary
